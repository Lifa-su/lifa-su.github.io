{
  /* 应用名称 */
  "name": "AI证件照",
  /* 应用描述 */
  "description": "智能AI证件照制作，一键生成标准证件照",
  /* 应用标识（请替换为实际 appid） */
  "appid": "your-appid-here",
  /* Vue 版本 */
  "vueVersion": "3",
  /* 版本信息 */
  "versionName": "1.0.0",
  "versionCode": "100",

  /* 微信小程序配置 */
  "mp-weixin": {
    /* 微信小程序 appid（请替换为实际 appid） */
    "appid": "your-weixin-appid-here",
    /* 项目设置 */
    "setting": {
      "urlCheck": true,
      "es6": true,
      "enhance": true,
      "postcss": true,
      "preloadBackgroundData": false,
      "minified": true,
      "newFeature": false,
      "coverView": true,
      "nodeModules": false,
      "autoAudits": false,
      "showShadowRootInWxmlPanel": true,
      "scopeDataCheck": false,
      "uglifyFileName": false,
      "checkInvalidKey": true,
      "checkSiteMap": true,
      "uploadWithSourceMap": true,
      "compileHotReLoad": false,
      "lazyloadPlaceholderEnable": false,
      "useMultiFrameRuntime": true,
      "useApiHook": true,
      "useApiHostProcess": true,
      "babelSetting": {
        "ignore": [],
        "disablePlugins": [],
        "outputPath": ""
      },
      "bundle": false,
      "useIsolateContext": true,
      "useCompilerModule": false,
      "userConfirmedUseCompilerModuleSwitch": false
    },
    /* 启用广告组件 */
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "用于获取您的位置信息"
      }
    },
    /* 隐私协议配置 */
    "privacySetting": {
      "privacyContractUrl": ""
    },
    /* 广告组件配置 */
    "functionalPages": false,
    "requiredBackgroundModes": [],
    "plugins": {},
    "resizable": false,
    "navigateToMiniProgramAppIdList": [],
    /* 启用 ad 广告组件 */
    "enableAd": true
  },

  /* H5 配置 */
  "h5": {
    "title": "AI证件照",
    "router": {
      "mode": "hash",
      "base": "./"
    },
    "devServer": {
      "port": 8080,
      "disableHostCheck": true,
      "proxy": {}
    },
    "optimization": {
      "treeShaking": {
        "enable": true
      }
    }
  }
}
